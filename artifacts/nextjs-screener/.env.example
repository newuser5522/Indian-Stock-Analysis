# Base path for Next.js deployment
NEXT_PUBLIC_BASE_PATH=/nextjs

# Database Configuration (Optional - features like watchlist require this)
# PostgreSQL connection string. If not set, database-dependent features will be disabled
# Example: postgresql://user:password@localhost:5432/stock_screener
DATABASE_URL=

# API Configuration
# Yahoo Finance API endpoint (usually doesn't need to be changed)
YAHOO_FINANCE_API=query1.finance.yahoo.com

# Cache TTL (milliseconds)
CACHE_TTL_MARKET=60000
CACHE_TTL_FUNDAMENTALS=300000
CACHE_TTL_SCREENER=120000

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Enable debug mode
DEBUG=false
